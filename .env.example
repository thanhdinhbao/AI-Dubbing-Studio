# AI Dubbing Studio Environment Configuration Example
# Copy this file to .env for development. Do NOT commit .env with real secret keys.

# Translation API (OpenAI-compatible)
TRANSLATION_BASE_URL=https://api.openai.com/v1
TRANSLATION_API_KEY=
TRANSLATION_MODEL=gpt-4o-mini

# TTS API (OpenAI-compatible or third-party)
TTS_API_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Local Models / Paths
OFFLINE_TTS_MODEL_PATH=
WHISPER_MODEL_DIR=

